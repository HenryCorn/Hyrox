{
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Jwt": {
    "Key": "CHANGE-ME-use-a-32+-char-secret-in-production",
    "Issuer": "hyrox-api",
    "Audience": "hyrox-app",
    "ExpiryMinutes": 43200
  },
  "AppleSignIn": {
    "AppBundleId": "com.quique.hyrox"
  },
  "GoogleSignIn": {
    "ClientId": "YOUR_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com"
  }
}
